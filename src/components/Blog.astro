---
import * as cheerio from 'cheerio'
import { XMLParser } from 'fast-xml-parser'
import Container from './Container.astro'

interface BlogPost {
  title: string
  link: string
  guid: string
  category: string[]
  'dc:creator': string
  pubDate: string
  'atom:updated': string
  'content:encoded': string
}

const res = await fetch('https://blog.fossnsbm.org/feed')
const xmlData = await res.text()
const parser = new XMLParser()

const blogData: BlogPost[] = parser.parse(xmlData).rss.channel.item
const latestPosts = blogData.slice(0, 3)
---

<div class="pt-32" id="blog">
  <Container>
      <div class="mb-12 space-y-2 text-center">
        <h2 class="text-3xl font-bold text-gray-800 md:text-4xl ">Latest Articles</h2>
        <p class="lg:mx-auto lg:w-6/12 text-gray-600 ">
        Find out what's our community talking about
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map(({title, guid, 'content:encoded': content}) => {
        const contentHTML = cheerio.load(content)
        return (
        <div class="group p-6 sm:p-8 rounded-3xl bg-white border border-gray-100 bg-opacity-50 shadow-2xl shadow-gray-600/10">
          <div class="relative overflow-hidden rounded-xl">
            <img src={contentHTML("img").first().attr("src")}
            alt="art cover" loading="lazy" width="1000" height="667" class="h-64 w-full object-contain transition duration-500 group-hover:scale-105"/>
          </div>
          <div class="mt-6 relative">
            <h3 class="text-2xl font-semibold text-gray-800 ">
              {title}
            </h3>
            <p class="mt-6 mb-8 text-gray-600 ">
            {contentHTML.text().slice(0, 120)}...
            </p>
            <a class="inline-block" href={guid}>
              <span class="text-info ">Read more</span>
            </a>
          </div>
        </div>
        )}
        )}
    </div>
  </Container>
</div>
